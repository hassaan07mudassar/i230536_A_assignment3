# ==============================================================================
# Environment Configuration Template - MLOps AI Agent
# Course: MLOps & Production AI Engineering (Fall 2026)
# Student: Hassaan Mudassar (i230536, Section CS-A)
# ==============================================================================

# LLM Provider Configuration (Gemini / OpenAI / Anthropic)
# Required for live agent mode; mock mode is used when unset or in offline tests
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=customer_churn_prediction

# Apache Airflow 3 Configuration
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_API_TIMEOUT_SECONDS=10

# Kubernetes Cluster Configuration
KUBERNETES_IN_CLUSTER=false
KUBERNETES_NAMESPACE=mlops-agent
KUBECONFIG_PATH=

# Security & Safety Guards (Non-Negotiable Allowlisting)
ALLOWED_NAMESPACES=mlops-agent,default
ALLOWED_DAG_IDS=ml_training_pipeline
ALLOWED_K8S_ACTIONS=restart,scale
MAX_MODEL_AGE_DAYS=30
QUALITY_GATE_MIN_F1=0.80

# Logging & Tracing
LOG_LEVEL=INFO
SERVICE_NAME=mlops-agent

